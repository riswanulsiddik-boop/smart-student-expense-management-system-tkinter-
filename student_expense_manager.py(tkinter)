    def add_expense(self):
        desc = self.exp_desc_var.get().strip()
        cat = self.exp_cat_var.get().strip()
        amt_str = self.exp_amt_var.get().strip()
        date_val = self.exp_date_var.get().strip()

        if not desc or not amt_str:
            messagebox.showwarning("Missing Info", "Please enter description and amount.")
            return
        try:
            amount = float(amt_str)
            if amount <= 0:
                raise ValueError("Amount must be greater than zero.")
        except ValueError as e:
            messagebox.showerror("Invalid Amount", f"Please enter a valid positive number for amount!\n{e}")
            return

        expense = {"date": date_val, "title": desc, "category": cat, "amount": amount}
        self.expenses.append(expense)

        self.refresh_expense_tree()
        self.exp_desc_var.set("")
        self.exp_amt_var.set("")
        self.save_expenses_to_file()
        messagebox.showinfo("Success", f"Expense of ₹{amount:.2f} recorded!")

    def delete_expense(self):
        selected = self.exp_tree.selection()
        if not selected:
            messagebox.showwarning("Select Row", "Please select an expense item to delete.")
            return

        idx = self.exp_tree.index(selected[0])
        del self.expenses[idx]
        self.refresh_expense_tree()
        self.save_expenses_to_file()
        messagebox.showinfo("Deleted", "Expense item deleted.")

    def refresh_expense_tree(self):
        for row in self.exp_tree.get_children():
            self.exp_tree.delete(row)

        total = 0.0
        for exp in self.expenses:
            amt = exp["amount"]
            total += amt
            self.exp_tree.insert("", "end", values=(exp["date"], exp["title"], exp["category"], f"₹{amt:,.2f}"))

        self.exp_total_label.config(text=f"Total Expenses: ₹{total:,.2f}  ({len(self.expenses)} entries)")

    def save_expenses_to_file(self):
        try:
            with open(EXPENSES_CSV, "w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(["Date", "Title", "Category", "Amount"])
                for e in self.expenses:
                    writer.writerow([e["date"], e["title"], e["category"], e["amount"]])
        except Exception as e:
            messagebox.showerror("File Error", f"Could not save expenses: {e}")

    def export_expenses_csv(self):
        if not self.expenses:
            messagebox.showinfo("Empty", "No expenses to export.")
            return
        path = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("CSV Files", "*.csv")], initialfile="expenses_export.csv")
        if path:
            try:
                with open(path, "w", newline="", encoding="utf-8") as f:
                    writer = csv.writer(f)
                    writer.writerow(["Date", "Title", "Category", "Amount"])
                    for e in self.expenses:
                        writer.writerow([e["date"], e["title"], e["category"], e["amount"]])
                messagebox.showinfo("Exported", f"Saved expenses report to {path}!")
            except Exception as e:
