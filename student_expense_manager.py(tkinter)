    def add_student(self):
        sid = self.st_id_var.get().strip()
        name = self.st_name_var.get().strip()
        age_str = self.st_age_var.get().strip()
        course = self.st_course_var.get().strip()
        fee = self.st_fee_var.get().strip()

        if not sid or not name or not age_str:
            messagebox.showwarning("Validation Error", "Please fill in Roll No, Name, and Age!")
            return

        try:
            age = int(age_str)
            if age <= 0 or age > 100:
                raise ValueError("Age must be between 1 and 100.")
        except ValueError as e:
            messagebox.showerror("Invalid Input", f"Age must be a valid number!\n{e}")
            return

        # Check for duplicate ID
        for s in self.students:
            if s["id"] == sid:
                messagebox.showerror("Duplicate ID", f"A student with Roll No/ID '{sid}' already exists!")
                return

        student = {"id": sid, "name": name, "age": age, "course": course, "fee": fee}
        self.students.append(student)
        self.refresh_student_tree()
        self.clear_student_form()
        self.save_students_to_file()
        messagebox.showinfo("Success", f"Student '{name}' added successfully!")

    def update_student(self):
        selected = self.st_tree.selection()
        if not selected:
            messagebox.showwarning("Selection Required", "Please select a student from the table to update.")
            return

        sid = self.st_id_var.get().strip()
        name = self.st_name_var.get().strip()
        age_str = self.st_age_var.get().strip()
        course = self.st_course_var.get().strip()
        fee = self.st_fee_var.get().strip()

        if not sid or not name or not age_str:
            messagebox.showwarning("Validation Error", "All fields are required!")
            return

        try:
            age = int(age_str)
        except ValueError:
            messagebox.showerror("Invalid Age", "Age must be an integer number.")
            return

        # Update in list
        item_id = selected[0]
        original_sid = self.st_tree.item(item_id)["values"][0]

        for s in self.students:
            if str(s["id"]) == str(original_sid):
                s["id"] = sid
                s["name"] = name
                s["age"] = age
                s["course"] = course
                s["fee"] = fee
                break

        self.refresh_student_tree()
        self.clear_student_form()
        self.save_students_to_file()
        messagebox.showinfo("Updated", f"Student '{name}' details updated successfully!")

    def delete_student(self):
        selected = self.st_tree.selection()
        if not selected:
            messagebox.showwarning("Selection Required", "Please select a student to delete.")
            return

        item = self.st_tree.item(selected[0])
        sid = str(item["values"][0])
        name = item["values"][1]

        confirm = messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete '{name}' (ID: {sid})?")
        if confirm:
            self.students = [s for s in self.students if str(s["id"]) != sid]
            self.refresh_student_tree()
            self.clear_student_form()
            self.save_students_to_file()
            messagebox.showinfo("Deleted", f"Student '{name}' deleted successfully.")

    def clear_student_form(self):
        self.st_id_var.set("")
        self.st_name_var.set("")
        self.st_age_var.set("")
        self.st_course_combo.current(0)
        self.st_fee_combo.current(0)

    def on_student_select(self, event):
        selected = self.st_tree.selection()
        if selected:
            values = self.st_tree.item(selected[0])["values"]
            self.st_id_var.set(values[0])
            self.st_name_var.set(values[1])
            self.st_age_var.set(values[2])
            self.st_course_var.set(values[3])
            self.st_fee_var.set(values[4])

    def refresh_student_tree(self, data_list=None):
        for row in self.st_tree.get_children():
            self.st_tree.delete(row)

        target = data_list if data_list is not None else self.students
        for s in target:
            self.st_tree.insert("", "end", values=(s["id"], s["name"], s["age"], s["course"], s["fee"]))

        self.st_count_label.config(text=f"Total Students: {len(self.students)}")

    def filter_students(self):
        q = self.st_search_var.get().strip().lower()
        if not q:
            self.refresh_student_tree()
        else:
            filtered = [s for s in self.students if q in str(s["id"]).lower() or q in s["name"].lower() or q in s["course"].lower()]
            self.refresh_student_tree(filtered)

    def save_students_to_file(self):
        try:
            with open(STUDENTS_CSV, "w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(["ID", "Name", "Age", "Course", "Fees"])
                for s in self.students:
                    writer.writerow([s["id"], s["name"], s["age"], s["course"], s["fee"]])
        except Exception as e:
            messagebox.showerror("File Error", f"Could not save student data: {e}")

    def export_students_csv(self):
        if not self.students:
            messagebox.showinfo("Empty", "No students to export.")
            return
        path = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("CSV Files", "*.csv")], initialfile="students_export.csv")
        if path:
            try:
                with open(path, "w", newline="", encoding="utf-8") as f:
                    writer = csv.writer(f)
                    writer.writerow(["ID", "Name", "Age", "Course", "Fees"])
                    for s in self.students:
                        writer.writerow([s["id"], s["name"], s["age"], s["course"], s["fee"]])
                messagebox.showinfo("Exported", f"Successfully exported {len(self.students)} students to {path}!")
            except Exception as e:
                messagebox.showerror("Export Failed", f"Error: {e}")

