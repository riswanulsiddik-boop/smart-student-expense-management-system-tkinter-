                            relief="flat", activebackground="#cbd5e1", command=lambda t=text: self.on_calc_btn_click(t))
            btn.grid(row=r, column=c, padx=4, pady=4)

    def on_calc_btn_click(self, char):
        current = self.calc_display_var.get()

        if char == "C":
            self.calc_display_var.set("0")
        elif char == "⌫":
            if len(current) > 1 and current != "Error":
                self.calc_display_var.set(current[:-1])
            else:
                self.calc_display_var.set("0")
        elif char == "=":
            try:
                # Sanitize input: allow only math characters
                safe_chars = "0123456789+-*/. "
                filtered = "".join([c for c in current if c in safe_chars])
                if not filtered:
                    return

                # Zero division check
                if "/0" in filtered.replace(" ", ""):
                    messagebox.showerror("Math Error", "ZeroDivisionError: Cannot divide by zero!")
                    self.calc_display_var.set("Error")
                    return

                # Evaluate arithmetic
                result = eval(filtered)
                # Format integer nicely if clean
                if isinstance(result, float) and result.is_integer():
                    result = int(result)
                self.calc_display_var.set(str(result))
            except ZeroDivisionError:
                messagebox.showerror("Zero Division", "Cannot divide by zero!")
                self.calc_display_var.set("Error")
            except Exception as e:
                messagebox.showerror("Syntax Error", f"Invalid math expression!\n{e}")
                self.calc_display_var.set("Error")
        else:
            if current in ("0", "Error"):
                self.calc_display_var.set(char)
            else:
                self.calc_display_var.set(current + char)

