            ("7", 2, 0, "#f1f5f9", "#1e293b"), ("8", 2, 1, "#f1f5f9", "#1e293b"), ("9", 2, 2, "#f1f5f9", "#1e293b"), ("*", 2, 3, "#3b82f6", "white"),
            ("4", 3, 0, "#f1f5f9", "#1e293b"), ("5", 3, 1, "#f1f5f9", "#1e293b"), ("6", 3, 2, "#f1f5f9", "#1e293b"), ("-", 3, 3, "#3b82f6", "white"),
