        self.style = ttk.Style()
        self.style.theme_use("clam")

        # Fonts
        self.font_header = ("Segoe UI", 16, "bold")
        self.font_sub = ("Segoe UI", 10)
        self.font_label = ("Segoe UI", 10, "bold")
        self.font_entry = ("Segoe UI", 10)

        # Tab styling
        self.style.configure("TNotebook", background="#f1f5f9", borderwidth=0)
        self.style.configure("TNotebook.Tab", font=("Segoe UI", 10, "bold"), padding=[16, 8], background="#e2e8f0")
        self.style.map("TNotebook.Tab",
                       background=[("selected", "#2563eb")],
                       foreground=[("selected", "white")])

        # Button styling
        self.style.configure("Primary.TButton", font=("Segoe UI", 10, "bold"), padding=6, background="#2563eb", foreground="white")
        self.style.map("Primary.TButton", background=[("active", "#1d4ed8")])

        self.style.configure("Success.TButton", font=("Segoe UI", 10, "bold"), padding=6, background="#10b981", foreground="white")
        self.style.map("Success.TButton", background=[("active", "#059669")])

        self.style.configure("Danger.TButton", font=("Segoe UI", 10, "bold"), padding=6, background="#ef4444", foreground="white")
        self.style.map("Danger.TButton", background=[("active", "#dc2626")])

        self.style.configure("Warning.TButton", font=("Segoe UI", 10, "bold"), padding=6, background="#f59e0b", foreground="white")
        self.style.map("Warning.TButton", background=[("active", "#d97706")])

        # Treeview styling
        self.style.configure("Treeview.Heading", font=("Segoe UI", 10, "bold"), background="#e2e8f0", foreground="#1e293b", padding=5)
        self.style.configure("Treeview", font=("Segoe UI", 10), rowheight=26, background="white", fieldbackground="white")
        self.style.map("Treeview", background=[("selected", "#3b82f6")], foreground=[("selected", "white")])

    # -------------------------------------------------------------------------
    # TOP HEADER BANNER
    # -------------------------------------------------------------------------
    def create_header(self):
        header_frame = tk.Frame(self.root, bg="#1e293b", height=70)
        header_frame.pack(fill=tk.X)

        title_lbl = tk.Label(header_frame, text="⚡ Smart Student & Expense Portal", font=self.font_header, fg="white", bg="#1e293b")
        title_lbl.pack(side=tk.LEFT, padx=20, pady=12)

        subtitle_lbl = tk.Label(header_frame, text="Python Tkinter Project", font=("Segoe UI", 10, "italic"), fg="#94a3b8", bg="#1e293b")
        subtitle_lbl.pack(side=tk.RIGHT, padx=20, pady=16)

    # -------------------------------------------------------------------------
    # MAIN TABS SETUP
    # -------------------------------------------------------------------------
    def create_tabs(self):
        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(fill=tk.BOTH, expand=True, padx=12, pady=10)

        # Tab 1: Students
