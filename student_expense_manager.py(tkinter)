import tkinter as tk
from tkinter import ttk, messagebox, filedialog
import csv
import os
from datetime import datetime

# File paths for saving dataS
STUDENTS_CSV = "students_data.csv"
EXPENSES_CSV = "expenses_data.csv"


class SmartManagementApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Smart Management System - Student & Expense Hub")
        self.root.geometry("860x680")
        self.root.minsize(800, 600)
        self.root.configure(bg="#f1f5f9")

        # In-memory storage
        self.students = []
        self.expenses = []

        # Configure Styles
        self.setup_styles()

        # Build Main UI
        self.create_header()
        self.create_tabs()

        # Load existing data if available
        self.load_initial_data()

